{
  "name": "le-prestige-residency-backend",
  "version": "1.0.0",
  "description": "Enterprise Firebase Backend & Cloud Functions for Le Prestige Residency",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:functions": "npm --prefix functions run build",
    "check-types": "tsc --noEmit && cd functions && tsc --noEmit",
    "test": "jest --passWithNoTests",
    "seed": "cross-env FIRESTORE_EMULATOR_HOST=localhost:8080 ts-node scripts/seedClient.ts",
    "seed:live": "ts-node scripts/seedClient.ts",
    "firebase:emulators": "firebase emulators:start",
    "firebase:deploy": "firebase deploy",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,storage:rules",
    "firebase:deploy:functions": "firebase deploy --only functions"
  },
  "keywords": [
    "firebase",
    "firestore",
    "cloud-functions",
    "razorpay",
    "hotel-booking",
    "backend"
  ],
  "author": "LE PRESTIGE RESIDENCY Engineering Team",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.5",
    "firebase": "^10.12.0",
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.0",
    "pdfkit": "^0.15.0",
    "razorpay": "^2.9.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@types/pdfkit": "^0.13.4",
    "cross-env": "^10.1.0",
    "firebase-tools": "^15.26.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
